[Unit]
Description=Claude Usage, widget de consommation au bord de l'ecran
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Electron ne sait pas se positionner sous Wayland : on force X11.
Environment=ELECTRON_OZONE_PLATFORM_HINT=x11
WorkingDirectory=%h/claude-usage
# On appelle le binaire Electron directement : le lanceur npm a besoin de
# node dans le PATH, que systemd ne fournit pas.
ExecStart=%h/claude-usage/node_modules/electron/dist/electron %h/claude-usage
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
