<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.claudemarge.widget</string>
  <key>ProgramArguments</key>
  <array>
    <string>__APP_DIR__/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron</string>
    <string>__APP_DIR__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <!-- Restart after a crash, but honour a deliberate Quit from the menu. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
  </dict>
  <key>StandardOutPath</key><string>__APP_DIR__/widget.log</string>
  <key>StandardErrorPath</key><string>__APP_DIR__/widget.log</string>
</dict>
</plist>
