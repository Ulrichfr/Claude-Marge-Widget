[Unit]
Description=Claude Marge Widget, la marge restante sur Claude Max, au bord de l'ecran
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Electron ne sait pas se positionner sous Wayland : on force X11.
Environment=ELECTRON_OZONE_PLATFORM_HINT=x11
WorkingDirectory=%h/marge
# On appelle le binaire Electron directement : le lanceur npm a besoin de
# node dans le PATH, que systemd ne fournit pas.
ExecStart=%h/marge/node_modules/electron/dist/electron %h/marge
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
