#!/usr/bin/env bash
# Claude Marge Widget, from the terminal.
#
#   marge            start it, or restart it if it is already running
#   marge stop       quit it until the next login
#   marge status     is it running, and what did it last read
#   marge logs       follow the log
#   marge settings   open the settings window
#   marge update     pull, install, test, restart
#
# Quitting from the tray menu takes the tray icon with it, so this and the
# Claude Marge launcher are the ways back.

set -euo pipefail

# `marge` s'installe comme lien symbolique dans ~/.local/bin. Sans resoudre le
# lien, APP_DIR pointe sur ~/.local, et tout ce qui touche au depot ou au
# journal echoue en silence : update ne met rien a jour, status ne trouve
# aucune lecture, logs suit un fichier inexistant.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$LINK_DIR/$SOURCE" ;; esac
done
APP_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
LABEL="com.claudemarge.widget"
UNIT="claude-marge.service"
LOG="$APP_DIR/widget.log"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"

is_mac() { [ "$(uname -s)" = "Darwin" ]; }

start() {
  if is_mac; then
    launchctl kickstart -k "gui/$(id -u)/$LABEL" 2>/dev/null ||
      launchctl bootstrap "gui/$(id -u)" "$PLIST"
  else
    systemctl --user restart "$UNIT" 2>/dev/null || {
      echo "systemd did not answer. Is this a graphical session?" >&2
      exit 1
    }
  fi
  echo "Claude Marge is running. Move the mouse to the right edge of the screen."
}

stop() {
  if is_mac; then launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  else systemctl --user stop "$UNIT" 2>/dev/null || true; fi
  echo "Claude Marge stopped. Start it again with: marge"
}

status() {
  if is_mac; then
    launchctl print "gui/$(id -u)/$LABEL" 2>/dev/null |
      grep -E "^	state|pid = " || echo "not registered"
  else
    systemctl --user is-active "$UNIT" 2>/dev/null ||
      echo "no answer from systemd (is there a graphical session on this machine?)"
  fi
  [ -f "$LOG" ] && { echo "last read:"; grep -v '^$' "$LOG" | tail -1; }
}

case "${1:-start}" in
  start|restart|"") start ;;
  stop) stop ;;
  status) status ;;
  logs) tail -f "$LOG" ;;
  settings)
    # There is no window to click when the widget is not running.
    start >/dev/null
    echo "Open the tray icon and choose Settings."
    ;;
  update)
    # Une mise a jour qui ne trouve pas son depot doit le dire, pas continuer.
    [ -d "$APP_DIR/.git" ] || {
      echo "marge: $APP_DIR n'est pas une copie git, mise a jour impossible" >&2
      exit 1
    }
    BEFORE="$(git -C "$APP_DIR" rev-parse HEAD)"
    git -C "$APP_DIR" pull --ff-only
    ( cd "$APP_DIR" && npm install --no-audit --no-fund >/dev/null && npm test >/dev/null )
    AFTER="$(git -C "$APP_DIR" rev-parse HEAD)"
    if [ "$BEFORE" = "$AFTER" ]; then
      echo "marge: deja a jour ($(git -C "$APP_DIR" log --oneline -1))"
    else
      echo "marge: $(git -C "$APP_DIR" log --oneline -1 "$BEFORE" | cut -c1-7) -> $(git -C "$APP_DIR" log --oneline -1 | cut -c1-7)"
    fi
    start
    ;;
  *)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
