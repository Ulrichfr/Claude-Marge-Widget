{
  "name": "claude-marge-widget",
  "version": "0.1.0",
  "description": "Claude Marge Widget : la marge qui te reste sur Claude Max, au bord de l'ecran",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "usage": "node src/usage.js",
    "test": "node test/geometry.test.js && node test/usage.test.js && node test/schedule.test.js && node test/alerts.test.js && node test/state.test.js && node test/i18n.test.js && node test/updater.test.js && node test/themes.test.js",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "author": "Ulrich Rozier",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0"
  },
  "build": {
    "appId": "com.claudemarge.widget",
    "productName": "Claude Marge Widget",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "LSUIElement": 1
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ulrichfr/Claude-Marge-Widget.git"
  },
  "homepage": "https://github.com/Ulrichfr/Claude-Marge-Widget"
}
